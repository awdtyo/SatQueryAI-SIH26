{
  "base_model": "Qwen/Qwen2-VL-2B-Instruct",
  "adapter_to_continue": "imadityasarkar/satquery-qwen2vl-stage1-bigearthnet",
  "subset_size": 1200,
  "val_ratio": 0.05,
  "image_max_pixels": 41216,
  "image_min_pixels": 200704,
  "max_seq_length": 1024,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0001,
  "lr_scheduler_type": "cosine",
  "warmup_ratio": 0.05,
  "num_train_epochs": 1,
  "max_steps": -1,
  "weight_decay": 0.01,
  "optim": "paged_adamw_8bit",
  "gradient_checkpointing": true,
  "max_grad_norm": 1.0,
  "save_steps": 25,
  "save_total_limit": 2,
  "logging_steps": 5,
  "eval_steps": 50,
  "seed": 3407,
  "notes": "Stage 2: VRSBench/RSVQA SFT \u2014 continues from stage1 adapter (BigEarthNet). Lower LR 1e-4 for SFT. Duplicate satquery_ai_qlora_finetune.ipynb -> vrsbench_rsvqa_sft.ipynb, set CHECKPOINT_DIR=stage2_vrsbench_sft and DATASET_CACHE_DIR=vrsbench_subset on Drive. See configs/README.md."
}
